# Aucun identifiant réel dans ce fichier. Copier vers .env.local.
# URL publique exacte, sans slash final. Laisser vide en développement.
NEXT_PUBLIC_SITE_URL=
# Laisser false pour une préproduction privée / non indexable.
SITE_INDEXABLE=false

# development : validation uniquement, jamais d'email ni de sauvegarde du message.
# resend : transmission réelle, sous réserve d'une configuration complète.
CONTACT_MODE=development
RESEND_API_KEY=
# Expéditeur sur un domaine vérifié dans Resend, ex. Cognalys <site@votre-domaine.fr>
CONTACT_FROM_EMAIL=
# Un seul destinataire, jamais fourni par le navigateur.
CONTACT_TO_EMAIL=
# Secret aléatoire >= 32 caractères. Générer avec :
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
CONTACT_TOKEN_SECRET=

# Redis partagé obligatoire en production (Vercel et serveur Node).
# Une base Upstash Redis REST convient. Ne jamais préfixer ces clés NEXT_PUBLIC_.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# auto : Vercel si détecté, sinon limite globale sûre.
# x-forwarded-for : UNIQUEMENT derrière un reverse proxy qui écrase cet en-tête.
CONTACT_IP_SOURCE=auto
# Origines supplémentaires explicitement autorisées, séparées par des virgules.
# Ne pas utiliser *. Le domaine principal est ajouté automatiquement.
CONTACT_ALLOWED_ORIGINS=

# Réservation optionnelle : lien HTTPS du calendrier public.
NEXT_PUBLIC_BOOKING_URL=
